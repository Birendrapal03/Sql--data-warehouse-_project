-- 1. Gender values distinct check
SELECT DISTINCT gen 
FROM bronze.erp_cust_az12;

-- 2. Future/invalid birthdates check
SELECT cid, bdate
FROM bronze.erp_cust_az12
WHERE bdate > CURRENT_DATE 
   OR bdate < '1900-01-01';

-- 3. CID format check (prefix pattern)
SELECT DISTINCT LEFT(cid, 3)
FROM bronze.erp_cust_az12;

INSERT INTO silver.erp_cust_az12 (
    cid,
    bdate,
    gen
)
SELECT
    -- Agar cid me 'NAS' prefix extra hai to remove karo (crm_cust_info.cst_key se match karne ke liye)
    CASE 
        WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid, 4, LENGTH(cid))
        ELSE cid
    END AS cid,

    -- Future dates ko NULL kar diya
    CASE 
        WHEN bdate > CURRENT_DATE THEN NULL
        ELSE bdate
    END AS bdate,

    -- Gender values ko standardize kiya
    CASE 
        WHEN UPPER(TRIM(gen)) IN ('M', 'MALE') THEN 'Male'
        WHEN UPPER(TRIM(gen)) IN ('F', 'FEMALE') THEN 'Female'
        ELSE 'n/a'
    END AS gen

FROM bronze.erp_cust_az12;

