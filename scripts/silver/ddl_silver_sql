-- 1. Distinct country values dekho
SELECT DISTINCT cntry
FROM bronze.erp_loc_a101
ORDER BY cntry;

-- 2. CID format check
SELECT cid
FROM bronze.erp_loc_a101
WHERE cid NOT LIKE 'AW-%';

-- 3. NULL/blank country check
SELECT cid, cntry
FROM bronze.erp_loc_a101
WHERE cntry IS NULL OR TRIM(cntry) = '';


INSERT INTO silver.erp_loc_a101 (
    cid,
    cntry
)
SELECT
    -- Hyphen remove karke cid ko clean kiya (match karne ke liye crm/erp customer tables se)
    REPLACE(cid, '-', '') AS cid,

    -- Country names ko standardize kiya
    CASE 
        WHEN TRIM(cntry) = 'US' THEN 'United States'
        WHEN TRIM(cntry) = 'DE' THEN 'Germany'
        WHEN TRIM(cntry) = '' OR cntry IS NULL THEN 'n/a'
        ELSE TRIM(cntry)
    END AS cntry

FROM bronze.erp_loc_a101;



